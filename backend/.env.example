# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/whatsviral
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
API_BASE_URL=https://api.whatsviral.in

# ─── DATA AGENTS ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
GOOGLE_NEWS_API_KEY=
APIFY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ─── AI PROVIDERS ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ─── VECTOR DATABASE ─────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=whatsviral-content

# ─── EMAIL ───────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@whatsviral.in
EMAIL_FROM_NAME=WhatsViral

# ─── AUTH ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# ─── FRONTEND ────────────────────────────────────────────────────────────────
FRONTEND_URL=https://whatsviral.in
ALLOWED_ORIGINS=https://whatsviral.in,https://www.whatsviral.in

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── EMBEDDINGS (self-hosted on Railway) ─────────────────────────────────────
MURIL_SERVICE_URL=http://muril:8080
INDICBERT_SERVICE_URL=http://indicbert:8080

# ─── GOOGLE PERSPECTIVE API (content moderation) ─────────────────────────────
PERSPECTIVE_API_KEY=

# ─── MONITORING ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
